# ===================================
# CONFIGURATION PRODUCTION - Frontend
# ===================================
# À copier dans .env sur le serveur avant le build

# URL de l'API backend en production — OBLIGATOIRE.
# Aucun fallback localhost en production : si VITE_API_URL est absent au build,
# l'application échoue explicitement au premier appel (pas de pointage silencieux
# vers localhost). Doit inclure le suffixe /api.
VITE_API_URL=https://votre-domaine.com/api

# Domaine du serveur Jitsi. OBLIGATOIRE — il n'a aucun défaut (#327).
# En production plus qu'ailleurs : cet exemple pointait vers meet.jit.si, donc
# vers un opérateur public. Aucune promesse de résidence des données ne tient
# dans ce cas, et le produit filme des apprenants.
VITE_JITSI_DOMAIN=visio.votre-domaine.com

# Profil réseau de la salle (#327) — facultatif, défauts conservateurs.
# VITE_VISIO_CHANNEL_LAST_N=2
# VITE_VISIO_VIDEO_HEIGHT=360
# VITE_VISIO_MAX_BITRATE_BPS=100000  # defaut Jitsi de la couche low

# Enregistrement visio provider/Jibri.
# Garder false tant que l'infrastructure backend/provider n'est pas validée.
VITE_VISIO_RECORDING_ENABLED=false

# NB : aucune valeur secrète dans ce fichier — les variables VITE_* sont
# embarquées dans le bundle public livré au navigateur.
