FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
ARG VITE_API_URL
# Aucune valeur par defaut : c'est le coeur de #327. Une valeur ici serait
# INLINEE par Vite dans le bundle, ce qui transformerait le `throw` de
# getJitsiDomain() en code mort — la garde JS ne se declencherait jamais sur le
# seul artefact reellement livre. Le fail-closed doit vivre dans la couche qui
# PRODUIT le bundle, pas seulement dans celle qui le consomme.
# `.dockerignore` exclut `.env*` : cet ARG est l'unique source de la variable.
ARG VITE_JITSI_DOMAIN
ARG VITE_VISIO_RECORDING_ENABLED=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_JITSI_DOMAIN=$VITE_JITSI_DOMAIN
ENV VITE_VISIO_RECORDING_ENABLED=$VITE_VISIO_RECORDING_ENABLED
RUN test -n "$VITE_JITSI_DOMAIN" || { \
      echo "VITE_JITSI_DOMAIN est obligatoire (#327) : passez --build-arg VITE_JITSI_DOMAIN=visio.votre-domaine.com" >&2; \
      exit 1; \
    }
RUN npm run build

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
