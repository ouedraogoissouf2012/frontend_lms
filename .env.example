# URL de votre API Laravel backend
VITE_API_URL=/api

# En production (cPanel), changez par votre vrai domaine :
# VITE_API_URL=https://api.votre-domaine.com/api

# Domaine du serveur Jitsi. OBLIGATOIRE — il n'a aucun défaut (#327).
# Sans lui, l'application refuse d'ouvrir une salle. C'est délibéré : le repli
# précédent envoyait la classe sur meet.jit.si, un opérateur public avec lequel
# personne n'a de contrat, sur un produit qui filme des apprenants.
# Écrire meet.jit.si reste possible, mais devient une décision, plus un défaut.
# NB : aucune valeur secrète ici — les variables VITE_* sont embarquées dans le
# bundle public livré au navigateur.
VITE_JITSI_DOMAIN=visio.votre-domaine.com

# Profil réseau de la salle (#327) — facultatif, défauts conservateurs.
# CHANNEL_LAST_N est le levier n°1 : Jitsi le laisse à -1 (« unlimited »), donc
# l'apprenant reçoit TOUS les flux. Valeurs provisoires, à ajuster après la
# mesure getStats demandée en lms_backend#700.
# VITE_VISIO_CHANNEL_LAST_N=2
# VITE_VISIO_VIDEO_HEIGHT=360
# VITE_VISIO_MAX_BITRATE_BPS=100000  # defaut Jitsi de la couche low

# Enregistrement visio provider/Jibri.
# Fail-closed par défaut : passer à true uniquement quand le backend et le
# provider réel sont configurés et validés.
VITE_VISIO_RECORDING_ENABLED=false
